{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/firewall.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/mtah-data/**)",
      "Edit(~/mtah-data/**)",
      "Read(./local_cache/**)",
      "Edit(./local_cache/**)",
      "Read(./private_out/**)",
      "Edit(./private_out/**)",
      "Read(./Makefile.private)",
      "Bash(*mtah*)",
      "Bash(*local_cache*)",
      "Bash(*private_out*)",
      "Bash(make private-*)"
    ]
  }
}
